# Files and directories to exclude from distribution
# Generated by Python virtual environments
venv/
env/
*.pyc
__pycache__/
*.pyo
*.pyd
.Python

# Generated by Airflow
logs/*
!logs/.gitkeep
*.log
airflow.db
airflow.cfg


# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Docker volumes (data persisted separately)
postgres-data/
minio-data/
metastore-db-data/
superset-data/

# Temporary files
.temp-files/
*.tmp
*.bak

DATAHUB_MIGRATION.md
ADDON_MIGRATION_COMPLETE.md